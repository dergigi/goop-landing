---
import '../styles/global.css';
import Ghost from '../components/Ghost.astro';
import DictationDemo from '../components/DictationDemo.astro';
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>Goop dictation social preview</title></head><body><main><header><Ghost class="ghost" />Goop <span>LOCAL DICTATION / 2.15.0</span></header><div class="content"><div><h1>Talk to<br />your <em>agents.</em></h1><p>Think out loud.<br />Send it over Nostr.</p><small>Parakeet v3 · 25 languages · On device</small></div><DictationDemo still /></div><footer>goop.dergigi.com/dictation <span>macOS · Windows · Linux</span></footer></main></body></html>
<style is:global>
 html { font-size:20px; } body { width:1200px; height:630px; background:radial-gradient(ellipse at 80% 50%,#8e4ec625,transparent 70%),var(--ink); } main { padding:40px 56px; height:100%; display:flex; flex-direction:column; } header { display:flex; align-items:center; gap:12px; font-size:26px; } header .ghost { width:32px; height:38px; } header > span { margin-left:auto; font-size:14px; color:var(--lilac-dim); letter-spacing:.1em; } .content { display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:40px; flex:1; } h1 { font-size:78px; font-weight:600; letter-spacing:-.075em; line-height:1.02; margin:0 0 24px; } h1 em { color:#c893f4; font-style:normal; } .content > div > p { font-size:24px; line-height:1.5; color:var(--lilac); margin:0 0 22px; } .content > div > small { color:var(--lilac-dim); font-size:13px; } footer { display:flex; justify-content:space-between; font-size:14px; color:var(--lilac-dim); } .dictation-demo .message-space { min-height:8rem; } .dictation-demo .spoken { font-size:1rem; }
</style>
