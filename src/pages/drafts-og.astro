---
import '../styles/global.css';
import Ghost from '../components/Ghost.astro';
import DraftNote from '../components/DraftNote.astro';
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>Goop drafts social preview</title></head>
  <body>
    <main>
      <header><Ghost class="ghost" />Goop <span>2.12.0</span></header>
      <div class="content">
        <div><h1>Finish it<br /><span>later.</span></h1><p>Your draft will be here.</p></div>
        <div class="note"><DraftNote /></div>
      </div>
      <footer>goop.dergigi.com/drafts <span>macOS · Windows · Linux</span></footer>
    </main>
  </body>
</html>
<style is:global>
  html { font-size: 20px; }
  body { width: 1200px; height: 630px; }
  main { padding: 48px 64px; height: 100%; display: flex; flex-direction: column; }
  header { display: flex; align-items: center; gap: 12px; font-size: 28px; }
  header .ghost { width: 36px; height: 42px; }
  header > span { margin-left: auto; font-size: 20px; color: var(--lilac-dim); }
  .content { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 36px; flex: 1; }
  h1 { margin: 0 0 22px; font-size: 76px; line-height: 1.03; letter-spacing: -.06em; font-weight: 600; }
  h1 span { color: #b77aeb; }
  .content > div > p { margin: 0; font-size: 22px; color: var(--lilac); }
  footer { display: flex; justify-content: space-between; font-size: 17px; color: var(--lilac-dim); }
</style>
