---
import '../styles/global.css';
import { getRelease } from '../lib/release';
import Kbd from '../components/Kbd.astro';
import DownloadPanel from '../components/DownloadPanel.astro';

const release = await getRelease();

const tagline = 'A simple NIP-17 client that just works.';
const guide = 'https://dergigi.com/goop/';
const repo = 'https://github.com/dergigi/goop';

const commands = [
  { id: 'macos', label: 'Download for macOS' },
  { id: 'windows', label: 'Download for Windows' },
  { id: 'linux', label: 'Download for Linux' },
  { id: 'shortcuts', label: 'Keyboard shortcuts' },
  { id: 'agents', label: 'Agents: let your bots DM you' },
  { id: 'guide', label: 'Usage guide' },
  { id: 'source', label: 'Source on GitHub' },
  { id: 'nip17', label: 'What is NIP-17?' },
];

// From the README. Mod is Cmd on macOS, Ctrl elsewhere.
const shortcuts: { keys: string[][]; does: string }[] = [
  { keys: [['?']], does: 'Keyboard shortcuts, when you are not typing' },
  { keys: [['Mod', 'K']], does: 'Search conversations and message contents' },
  { keys: [['Mod', 'P']], does: 'Search profiles by name, address, or public key' },
  { keys: [['Up'], ['Down'], ['Enter'], ['Esc']], does: 'Pick a result, open it, go back' },
  { keys: [['Mod', 'F']], does: 'Find in the current chat' },
  { keys: [['Mod', '1'], ['Mod', '2'], ['Mod', '3']], does: 'Inbox, Requests, message box' },
  { keys: [['Mod', 'N'], ['Mod', 'T']], does: 'New chat' },
  { keys: [['Mod', 'Shift', 'N']], does: 'New group' },
  { keys: [['Mod', 'B']], does: 'Show or hide the sidebar' },
  { keys: [['Mod', 'W'], ['Mod', 'Shift', 'T']], does: 'Close tab, restore a closed tab' },
  { keys: [['Ctrl', 'Tab']], does: 'Next tab, on every platform' },
  { keys: [['Mod', 'R']], does: 'Reload messaging and rescan history' },
  { keys: [['Mod', 'Shift', 'C']], does: 'Contacts' },
  { keys: [['Mod', 'Shift', 'P']], does: 'Your profile' },
  { keys: [['Mod', 'Shift', 'M']], does: 'Messaging relays' },
  { keys: [['Mod', 'Shift', 'G']], does: 'Gossip relays' },
  { keys: [['Mod', 'Comma']], does: 'Settings' },
  { keys: [['Enter'], ['Shift', 'Enter']], does: 'Send, or insert a newline' },
];

const links = {
  source: [
    { name: 'dergigi/goop', desc: 'source, issues, pull requests', url: repo },
    { name: 'CHANGELOG.md', desc: 'what changed, release by release', url: `${repo}/blob/master/CHANGELOG.md` },
    { name: 'Releases', desc: 'every build, with SHA256SUMS', url: `${repo}/releases` },
    { name: 'reya/coop', desc: 'upstream, which Goop forks', url: 'https://git.reya.info/reya/coop' },
  ],
  nip17: [
    { name: 'NIP-17', desc: 'Private Direct Messages', url: 'https://github.com/nostr-protocol/nips/blob/master/17.md' },
    { name: 'NIP-59', desc: 'Gift Wrap', url: 'https://github.com/nostr-protocol/nips/blob/master/59.md' },
    { name: 'NIP-44', desc: 'Encrypted Payloads', url: 'https://github.com/nostr-protocol/nips/blob/master/44.md' },
    { name: 'WhiteNoise', desc: 'if NIP-17 is not enough for you', url: 'https://www.whitenoise.chat/' },
  ],
};

const openclawPrompt = `Use clawhub.ai/dergigi/nihao to create a nostr identity for yourself &
after that use github.com/fabianfabian/openclaw-nostr-nip17
to set yourself up with NIP-17. DM me when you’re done.
My nostr identity is PASTE_YOUR_NPUB_HERE`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Goop – {tagline}</title>
    <meta name="description" content={`Goop is a keyboard-first desktop client for NIP-17 private messages on Nostr. ${tagline} Free software for macOS, Windows, and Linux.`} />
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="preload" href="/fonts/cascadia-code-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.dataset.os = /Mac|iPhone|iPad/.test(navigator.platform) ? 'mac' : 'other';
    </script>
  </head>
  <body>
    <svg class="sr-only" aria-hidden="true" focusable="false">
      <symbol id="i-cmd" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.1" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 8h8v8H8z" />
        <path d="M8 8V5a3 3 0 1 0-3 3h3M16 8V5a3 3 0 1 1 3 3h-3M8 16v3a3 3 0 1 1-3-3h3M16 16v3a3 3 0 1 0 3-3h-3" />
      </symbol>
    </svg>
    <main class="palette" aria-label="Goop">
      <header class="bar">
        <svg class="ghost" viewBox="0 0 500 500" aria-hidden="true" focusable="false">
          <g fill="currentColor" transform="translate(0 -28)">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M120 210C120 110 190 50 255 52C335 54 400 115 392 205C388 245 372 270 370 300C368 330 380 355 378 390C376 425 335 428 330 392C327 365 340 345 332 320C324 300 300 300 292 320C285 340 290 385 278 415C270 445 220 445 212 415C204 385 216 355 208 335C200 305 170 300 165 325C160 350 172 372 168 395C164 425 125 425 122 393C119 360 135 340 130 300C126 265 120 245 120 210ZM183 185a24 24 0 1 0 48 0a24 24 0 1 0-48 0ZM269 185a24 24 0 1 0 48 0a24 24 0 1 0-48 0Z" />
            <path d="M245 448C258 466 264 476 264 486A19 19 0 0 1 226 486C226 476 232 466 245 448Z" />
          </g>
        </svg>
        <label class="query">
          <span class="sr-only">Filter commands</span>
          <input id="query" type="text" placeholder="goop" autocomplete="off" spellcheck="false" autofocus />
        </label>
        <span class="hint">esc to clear</span>
      </header>

      <nav class="commands" aria-label="Commands">
        <ul role="listbox" aria-label="Commands">
          {commands.map((c, i) => (
            <li role="option" aria-selected={i === 0 ? 'true' : 'false'} class:list={['row', { active: i === 0 }]}>
              <a href={`#${c.id}`} data-id={c.id}>
                <span class="label">{c.label}</span>
                <Kbd k={String(i + 1)} />
              </a>
            </li>
          ))}
          <li class="no-match" hidden>No matching command</li>
        </ul>
      </nav>

      <section class="preview">
        <DownloadPanel id="macos" name="macOS" {release} {tagline} note="ad-hoc signed, not notarized" active>
          <p class="more">
            First launch: macOS will say it cannot verify the developer. Right-click <span class="name">Goop.app</span>, choose Open, and confirm.
          </p>
        </DownloadPanel>

        <DownloadPanel id="windows" name="Windows" {release} {tagline} note="unsigned, SmartScreen will warn">
          <p class="more">
            First launch: SmartScreen shows “Windows protected your PC”. Pick More info, then Run anyway.
          </p>
        </DownloadPanel>

        <DownloadPanel id="linux" name="Linux" {release} {tagline} note="Flatpak, Snap, or a plain tarball">
          <p class="more">
            The Snap is not in the store yet. Install with <span class="name">snap install --dangerous --classic goop*.snap</span>.
          </p>
        </DownloadPanel>

        <article id="shortcuts" class="panel" hidden>
          <h1>Keyboard shortcuts</h1>
          <p class="tagline">Designed for people who love the keyboard.</p>
          <ul class="files table">
            {shortcuts.map((s) => (
              <li class="shortcut">
                <span class="keys">
                  {s.keys.map((combo, i) => (
                    <>
                      {i > 0 && <span class="or" aria-label="or">/</span>}
                      <span class="combo">{combo.map((k) => <Kbd k={k} />)}</span>
                    </>
                  ))}
                </span>
                <span class="does">{s.does}</span>
              </li>
            ))}
          </ul>
          <p class="note">
            Mod is <Kbd k="Mod" class="inline" /> on this machine. Press <Kbd k="?" class="inline" /> inside Goop for the full list.
          </p>
        </article>

        <article id="agents" class="panel" hidden>
          <h1>Agents: let your bots DM you</h1>
          <p class="tagline">Get updates from your agents. Reply in Goop.</p>
          <p class="more">
            Each agent needs its own Nostr identity and a NIP-17 integration. Give it your public key (npub) as its contact, then accept its first message in Requests.
          </p>
          <div class="prompt">
            <div class="prompt-head">
              <span>OpenClaw, tested with Goop. Send this to your agent:</span>
              <button type="button" data-copy="openclaw-prompt">copy</button>
            </div>
            <pre id="openclaw-prompt">{openclawPrompt}</pre>
          </div>
          <p class="more">
            Replace <span class="name">PASTE_YOUR_NPUB_HERE</span> with your npub. Hermes and NullClaw have NIP-17 channels too, untested with Goop so far. <a href={`${guide}#agent-guide`}>Agent guide</a>
          </p>
        </article>

        <article id="guide" class="panel" hidden>
          <h1>Usage guide</h1>
          <p class="tagline">Setup, shortcuts, agents. All on one page.</p>
          <ul class="files links">
            <li><a href={guide}><span class="name">dergigi.com/goop</span><span class="desc">the usage guide</span></a></li>
            <li><a href={`${guide}#keyboard-shortcuts`}><span class="name">#keyboard-shortcuts</span><span class="desc">every key, on every platform</span></a></li>
            <li><a href={`${guide}#agent-guide`}><span class="name">#agent-guide</span><span class="desc">OpenClaw, Hermes, NullClaw</span></a></li>
          </ul>
          <p class="more">
            Goop signs with an external signer and speaks NIP-17 only. No NIP-04, no plaintext fallback. If something is missing, <a href={`${repo}/issues`}>open an issue</a>.
          </p>
        </article>

        <article id="source" class="panel" hidden>
          <h1>Source on GitHub</h1>
          <p class="tagline">Rust on GPUI. GPL-3.0. Fork of Coop.</p>
          <ul class="files links">
            {links.source.map((l) => (
              <li><a href={l.url}><span class="name">{l.name}</span><span class="desc">{l.desc}</span></a></li>
            ))}
          </ul>
          <p class="more">
            Goop follows Semantic Versioning and Keep a Changelog. Every release ships with a SHA256SUMS file, so you can check what you downloaded.
          </p>
        </article>

        <article id="nip17" class="panel" hidden>
          <h1>What is NIP-17?</h1>
          <p class="tagline">Private direct messages on Nostr.</p>
          <p class="more">
            Your message is wrapped three times. The unsigned message (the rumor) is sealed with your key, then the seal is gift-wrapped with a throwaway key and a randomised timestamp. Relays see a random sender and a blob, nothing else.
          </p>
          <ul class="files links">
            {links.nip17.map((l) => (
              <li><a href={l.url}><span class="name">{l.name}</span><span class="desc">{l.desc}</span></a></li>
            ))}
          </ul>
          <p class="more">
            Attachments are encrypted per file before upload; the key travels only inside the message.
          </p>
        </article>
      </section>

      <footer class="status">
        <a href={release.url}>goop v{release.version}</a>
        <span>NIP-17 · GPL-3.0 · macOS Windows Linux</span>
        <span>? for shortcuts</span>
      </footer>
    </main>
    <script src="../scripts/palette.ts"></script>
  </body>
</html>

<style is:global>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .palette {
    display: grid;
    grid-template-columns: 40.3% 1fr;
    grid-template-rows: auto 1fr auto;
    grid-template-areas:
      'bar bar'
      'commands preview'
      'status status';
    height: 100dvh;
    min-height: 720px;
  }

  /* Input bar */
  .bar {
    grid-area: bar;
    display: flex;
    align-items: center;
    height: 74px;
    margin: 12px 12px 0;
    padding: 0 30px 0 15px;
    border: var(--rule);
    border-radius: var(--radius);
  }
  .ghost {
    flex: none;
    width: 56px;
    height: 56px;
    color: var(--text);
  }
  .query {
    flex: 1;
    display: flex;
    margin-left: 22px;
  }
  .query input {
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 23px;
    caret-color: var(--brand);
  }
  .query input::placeholder {
    color: var(--text);
    opacity: 1;
    font-weight: 700;
  }
  .query input:focus-visible {
    outline: none;
  }
  .hint {
    font-size: 23px;
  }

  /* Command list */
  .commands {
    grid-area: commands;
    padding: 19px 18px 0 19px;
    border-right: var(--rule);
    overflow-y: auto;
  }
  .commands ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    height: 62.5px;
    padding: 2.5px 0 3px;
  }
  .row a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    padding: 0 13px 0 19px;
    border-radius: 4px;
    font-size: 23px;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .row .label {
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: 12px;
  }
  .row.active a {
    background: var(--purple);
    color: #fff;
  }
  .row.active .key {
    color: #f3dafe;
    border-color: #f3dafe;
    box-shadow: 0 0 0 1px color-mix(in oklab, #f3dafe 45%, transparent);
  }
  .no-match {
    padding: 18px 19px;
    color: var(--lilac);
    font-size: 23px;
  }

  /* Preview */
  .preview {
    grid-area: preview;
    padding: 33px 36px 0 30px;
    overflow-y: auto;
    scrollbar-gutter: stable;
  }
  /* Without JS, the hash picks the panel. */
  .preview:has(.panel:target) .panel:not(:target) {
    display: none;
  }
  .panel[hidden]:target {
    display: block;
  }
  .panel {
    scroll-margin-top: 33px;
    /* Runs each time a panel goes from hidden to shown. */
    animation: panel-in 120ms ease-out;
  }
  @keyframes panel-in {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel {
      animation: none;
    }
  }
  .panel h1 {
    margin: 0 0 0 8px;
    font-size: 34px;
    font-weight: 400;
    line-height: 1;
  }
  .tagline {
    margin: 19px 0 0 8px;
    color: var(--lilac);
    font-size: 23px;
    line-height: 1;
  }
  .files {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    border-top: var(--rule);
  }
  .files li {
    border-bottom: var(--rule);
  }
  .files a {
    display: grid;
    grid-template-columns: 20ch 6ch auto;
    gap: 2.5ch;
    align-items: center;
    height: 50px;
    padding: 0 16px;
    font-size: 23px;
  }
  .files.links a {
    grid-template-columns: 1fr auto;
  }
  .files .desc {
    color: var(--lilac);
    font-size: 20px;
  }
  .files a:hover {
    color: var(--lilac);
  }
  .note {
    margin: 15px 0 0 5px;
    color: var(--lilac);
    font-size: 20px;
    line-height: 1;
  }
  .panel a:not(.files a) {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--lilac-dim);
  }
  .shot {
    position: relative;
    display: grid;
    place-items: center;
    height: 259px;
    margin: 18px 0 0;
    border: var(--rule);
    border-radius: 8px;
    overflow: hidden;
    color: var(--lilac);
    font-size: 20px;
  }
  .shot.has-img {
    height: auto;
    display: block;
  }
  .shot img {
    display: block;
    width: 100%;
  }
  .dots {
    position: absolute;
    top: 14px;
    left: 16px;
    display: flex;
    gap: 8px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--lilac);
  }

  /* Text beyond the comp: same voice, a size down. */
  .more {
    max-width: 62ch;
    margin: 22px 0 0 8px;
    font-size: 20px;
    line-height: 1.45;
  }
  .more .name {
    color: var(--lilac);
  }
  .panel > :last-child {
    padding-bottom: 33px;
  }

  /* Shortcut table */
  .table .shortcut {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 2.5ch;
    align-items: center;
    min-height: 50px;
    padding: 6px 16px;
    font-size: 20px;
  }
  .keys {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
  }
  .combo {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .combo .key + .key::before {
    content: '';
  }
  .or {
    color: var(--lilac-faint);
  }
  .table .key {
    font-size: 15px;
  }
  .key.inline {
    font-size: 14px;
    vertical-align: middle;
  }
  .note:has(.key) {
    margin-top: 20px;
    line-height: 1.5;
  }

  /* Agent prompt */
  .prompt {
    margin: 22px 0 0;
    border: var(--rule);
    border-radius: 8px;
  }
  .prompt-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
    border-bottom: var(--rule);
    color: var(--lilac);
    font-size: 18px;
  }
  .prompt button {
    padding: 4px 12px;
    border: var(--rule);
    border-radius: 6px;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 18px;
    cursor: pointer;
  }
  .prompt button:hover {
    background: var(--purple);
  }
  .prompt pre {
    margin: 0;
    padding: 16px;
    font: inherit;
    font-size: 18px;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* Status bar */
  .status {
    grid-area: status;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 58px;
    padding: 0 40px 0 26px;
    border-top: var(--rule);
    color: var(--lilac);
    font-size: 21px;
  }
  .status span:last-child {
    text-align: right;
  }
</style>
