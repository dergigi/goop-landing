---
import '../styles/global.css';
import { getRelease, filesFor, type Platform } from '../lib/release';
import Kbd from '../components/Kbd.astro';
import DownloadIcon from '../components/DownloadIcon.astro';
import CopyButton from '../components/CopyButton.astro';
import InstallCommands from '../components/InstallCommands.astro';
import DownloadPanel from '../components/DownloadPanel.astro';
import Ghost from '../components/Ghost.astro';
import { allScreenshots } from '../lib/screenshots';

const release = await getRelease();
const screenshots = allScreenshots();

const tagline = 'A native NIP-17 client to chat with your clankers (and friends)';
// Shared by the meta description and the social cards; kept under 125 characters.
const description = `${tagline}. Free software for macOS, Windows, and Linux.`;
const guide = 'https://dergigi.com/goop/';
const repo = 'https://github.com/dergigi/goop';
const goopProfile = 'https://njump.to/npub1vnl7t2z4vy28lwthaavlpsxq67qnwqss0jz2t9jg3ealzjs43y6q5hwqec';

// `alias` holds extra words the filter matches, so "help" finds the guide.
const commands = [
  { id: 'get', label: 'Get Goop', alias: 'download install screenshots pictures' },
  { id: 'features', label: 'Features', alias: 'what can it do' },
  { id: 'macos', label: 'Download for macOS', alias: 'mac apple dmg brew homebrew cask' },
  { id: 'windows', label: 'Download for Windows', alias: 'win exe' },
  { id: 'linux', label: 'Download for Linux', alias: 'flatpak snap tarball arch aur omarchy' },
  { id: 'agents', label: 'Agents: let your bots DM you', alias: 'ai openclaw hermes nullclaw' },
  { id: 'guide', label: 'Usage guide', alias: 'help docs manual how to' },
  { id: 'source', label: 'Source on GitHub', alias: 'code repo git changelog releases' },
  { id: 'nip17', label: 'What is NIP-17?', alias: 'dm private messages encryption gift wrap' },
  { id: 'shortcuts', label: 'Keyboard shortcuts', key: '?', alias: 'keys hotkeys' },
];

// The first row is highlighted on load, so its panel is the one shown.
const initial = commands[0].id;

// One big download per platform on the Get Goop panel. The visitor's own OS is
// picked by data-os; the other two stay in the DOM and are hidden by CSS.
// Architecture cannot be detected in the browser, so the common one is primary
// and the other is a plain link next to it.
const picks: { id: Platform; name: string; file: string; alt?: string; more: string }[] = [
  { id: 'macos', name: 'macOS', file: 'goop-macos-arm64.dmg', alt: 'goop-macos-x64.dmg', more: 'Homebrew, first launch' },
  { id: 'windows', name: 'Windows', file: 'goop-windows-x64.exe', alt: 'goop-windows-arm64.exe', more: 'First launch notes' },
  { id: 'linux', name: 'Linux', file: 'goop-linux-x64.flatpak', more: 'Snap, tarball, arm64' },
];
const primary = picks.map((p) => {
  const files = filesFor(release, p.id);
  const pick = (name?: string) => files.find((f) => f.name === name);
  return { ...p, main: pick(p.file) ?? files[0], alt: pick(p.alt) };
});

// Matches the app’s shortcuts. Mod is Cmd on macOS, Ctrl elsewhere.
const shortcuts: { keys: string[][]; does: string }[] = [
  { keys: [['?']], does: 'Keyboard shortcuts, when you are not typing' },
  { keys: [['Mod', 'K']], does: 'Search conversations and message contents' },
  { keys: [['Mod', 'P']], does: 'Search profiles by name, address, or public key' },
  { keys: [['Up'], ['Down'], ['Enter'], ['Esc']], does: 'Pick a result, open it, go back' },
  { keys: [['Mod', 'F']], does: 'Find in the current chat' },
  { keys: [['Mod', '1']], does: 'Inbox' },
  { keys: [['Mod', '2']], does: 'Requests' },
  { keys: [['Mod', '3']], does: 'Focus message box' },
  { keys: [['Mod', 'N'], ['Mod', 'T']], does: 'New chat' },
  { keys: [['Mod', 'Shift', 'N']], does: 'New group' },
  { keys: [['Mod', 'Shift', 'S']], does: 'Note to self' },
  { keys: [['Mod', 'B']], does: 'Show or hide the sidebar' },
  { keys: [['Mod', 'W']], does: 'Close tab' },
  { keys: [['Mod', 'Shift', 'W']], does: 'Close all tabs' },
  { keys: [['Mod', 'Shift', 'T']], does: 'Reopen closed tab' },
  { keys: [['Ctrl', 'Tab']], does: 'Next tab, on every platform' },
  { keys: [['Ctrl', 'Shift', 'Tab']], does: 'Previous tab, on every platform' },
  { keys: [['Mod', 'R']], does: 'Reload history and retry sends / decryption' },
  { keys: [['Mod', 'Shift', 'C']], does: 'Contacts' },
  { keys: [['Mod', 'Shift', 'P']], does: 'Your profile' },
  { keys: [['Mod', 'Shift', 'M']], does: 'Messaging relays' },
  { keys: [['Mod', 'Shift', 'G']], does: 'Gossip relays' },
  { keys: [['Mod', 'Shift', 'R']], does: 'Private storage relays' },
  { keys: [['Mod', 'Shift', 'D']], does: 'Connection status' },
  { keys: [['Mod', 'Comma']], does: 'Settings' },
  { keys: [['Enter']], does: 'Send message (in the message box)' },
  { keys: [['Shift', 'Enter']], does: 'Insert a newline (in the message box)' },
  { keys: [['Enter']], does: 'Next match (in chat find)' },
  { keys: [['Shift', 'Enter']], does: 'Previous match (in chat find)' },
  { keys: [['Left'], ['Right']], does: 'Previous / next image (in the gallery)' },
  { keys: [['Esc']], does: 'Close the gallery' },
  { keys: [['Cmd', 'Q']], does: 'Quit Goop (macOS)' },
  { keys: [['Super', 'Q']], does: 'Quit Goop (Linux / Windows)' },
];

// From README.md and CHANGELOG.md; nothing here that Goop does not ship.
const features = [
  { name: 'Keyboard first', desc: '? lists every shortcut' },
  { name: 'NIP-17 only', desc: 'gift-wrapped DMs and groups' },
  { name: 'External signer', desc: 'your key stays in your signer' },
  { name: 'Encrypted attachments', desc: 'encrypted before upload' },
  { name: 'Search', desc: 'chats, messages, profiles' },
  { name: 'Tabs, pins, archive', desc: 'Amethyst pins, Nospeak archives' },
  { name: 'Unread controls', desc: 'counts, mark read or unread' },
  { name: 'Profiles', desc: 'view, chat, and search in the sidepane' },
  { name: 'Note to self', desc: 'a private chat for your own notes' },
  { name: 'Agents', desc: 'OpenClaw can DM you' },
  { name: 'Native', desc: 'Rust on GPUI, macOS Windows Linux' },
  { name: 'Free software', desc: 'GPL-3.0' },
];

const links = {
  source: [
    { name: 'dergigi/goop', desc: 'source, issues, pull requests', url: repo },
    { name: 'CHANGELOG.md', desc: 'what changed, release by release', url: `${repo}/blob/master/CHANGELOG.md` },
    { name: 'Releases', desc: 'every build, with SHA256SUMS', url: `${repo}/releases` },
  ],
  nip17: [
    { name: 'NIP-17', desc: 'Private Direct Messages', url: 'https://github.com/nostr-protocol/nips/blob/master/17.md' },
    { name: 'NIP-59', desc: 'Gift Wrap', url: 'https://github.com/nostr-protocol/nips/blob/master/59.md' },
    { name: 'NIP-44', desc: 'Encrypted Payloads', url: 'https://github.com/nostr-protocol/nips/blob/master/44.md' },
  ],
};

const openclawPrompt = `Use clawhub.ai/dergigi/nihao to create a nostr identity for yourself &
after that use github.com/fabianfabian/openclaw-nostr-nip17
to set yourself up with NIP-17. DM me when you’re done.
My nostr identity is PASTE_YOUR_NPUB_HERE`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Get Goop · {tagline}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/goop.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link rel="canonical" href={Astro.site} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:title" content="Get Goop" />
    <meta property="og:site_name" content="Goop" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Goop command palette: goop, A native NIP-17 client to chat with your clankers (and friends). Get Goop, Features, Download for macOS/Linux/Windows" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Get Goop" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <link rel="preload" href="/fonts/cascadia-code-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // macos | windows | linux | other. Android reports "Linux", so it is checked first.
      document.documentElement.dataset.os = (function (p, ua) {
        if (/Mac|iPhone|iPad/.test(p)) return 'macos';
        if (/Win/.test(p)) return 'windows';
        if (/Linux|X11/.test(p) && !/Android/.test(ua)) return 'linux';
        return 'other';
      })(navigator.platform, navigator.userAgent);
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <svg class="sr-only" aria-hidden="true" focusable="false">
      <symbol id="i-cmd" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.1" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 8h8v8H8z" />
        <path d="M8 8V5a3 3 0 1 0-3 3h3M16 8V5a3 3 0 1 1 3 3h-3M8 16v3a3 3 0 1 1-3-3h3M16 16v3a3 3 0 1 0 3-3h-3" />
      </symbol>
    </svg>
    <main class="palette" aria-label="Goop">
      <header class="bar">
        <Ghost class="ghost" />
        <label class="query">
          <span class="sr-only">Filter commands</span>
          <input id="query" type="text" placeholder="goop" autocomplete="off" spellcheck="false" />
          <span class="caret" aria-hidden="true"></span>
        </label>
        <span class="hint">esc to clear</span>
      </header>

      <nav class="commands" aria-label="Commands">
        <ul role="listbox" aria-label="Commands">
          {commands.map((c, i) => (
            <li role="option" aria-selected={i === 0 ? 'true' : 'false'} class:list={['row', { active: i === 0 }]}>
              <a href={`#${c.id}`} data-id={c.id} data-alias={c.alias}>
                <span class="label">{c.label}</span>
                <Kbd k={c.key ?? String((i + 1) % 10)} />
              </a>
            </li>
          ))}
          <li class="no-match" hidden>No matching command</li>
        </ul>
      </nav>

      <section class="preview">
        <DownloadPanel id="macos" name="macOS" {release} {tagline} note="ad-hoc signed, not notarized" active={initial === 'macos'}>
          <p class="more">
            First launch: macOS will say it cannot verify the developer. Open System Settings › Privacy &amp; Security and click Open Anyway. Or, once <span class="name">Goop.app</span> is in Applications, clear the quarantine flag and skip the dialog:
          </p>
          <p class="shell">
            <code id="mac-xattr">xattr -dr com.apple.quarantine /Applications/Goop.app</code>
            <CopyButton target="mac-xattr" />
          </p>
        </DownloadPanel>

        <DownloadPanel id="windows" name="Windows" {release} {tagline} note="unsigned, SmartScreen will warn" active={initial === 'windows'}>
          <p class="more">
            First launch: SmartScreen shows “Windows protected your PC”. Pick More info, then Run anyway.
          </p>
        </DownloadPanel>

        <DownloadPanel id="linux" name="Linux" {release} {tagline} note="Flatpak, Snap, or a plain tarball" active={initial === 'linux'}>
          <p class="more">
            The Snap is not in the store yet. Install with <span class="name">snap install --dangerous --classic goop*.snap</span>.
          </p>
        </DownloadPanel>

        <article id="get" class="panel" hidden={initial !== 'get'}>
          <h1>Get Goop</h1>
          <p class="tagline">{tagline}</p>
          {primary.map((p) => (
            <div class="get" data-os={p.id}>
              <InstallCommands platform={p.id} prefix={`get-${p.id}`} />
              <a class="button" href={p.main.url} download>
                <span class="download-details">
                  <span class="label">Download for {p.name}</span>
                  <span class="meta">v{release.version} · {p.main.arch} · {p.main.size}</span>
                </span>
                <DownloadIcon />
              </a>
              <p class="note">
                {p.alt && <>{p.alt.arch}: <a href={p.alt.url} download>{p.alt.name}</a> · </>}
                <a href={`#${p.id}`}>{p.more}</a>
              </p>
            </div>
          ))}
          <p class="note get-other">
            Also for {primary.map((p, i) => <><a href={`#${p.id}`} data-os={p.id}>{p.name}</a>{i < primary.length - 1 && ' '}</>)}
          </p>
          {screenshots.map((s) => (
            <figure class="shot has-img">
              <img src={s.src} width={s.width} height={s.height} alt={`Goop: ${s.caption}`} loading="lazy" decoding="async" />
              <figcaption>{s.caption}</figcaption>
            </figure>
          ))}
        </article>

        <article id="features" class="panel" hidden={initial !== 'features'}>
          <h1>Features</h1>
          <p class="tagline">What Goop does.</p>
          <ul class="files links features">
            {features.map((f) => (
              <li><span class="row-static"><span class="name">{f.name}</span><span class="desc">{f.desc}</span></span></li>
            ))}
          </ul>
          <p class="more">
            <a href="/drafts">Saved drafts</a> · <a href="/clankers">Clankers &amp; friends</a><br />
            Goop skips NIP-04 and read receipts. The <a href={`${repo}/blob/master/CHANGELOG.md`}>changelog</a> has the details for each release.
          </p>
        </article>

        <article id="shortcuts" class="panel" hidden={initial !== 'shortcuts'}>
          <h1>Keyboard shortcuts</h1>
          <p class="tagline">Designed for people who love the keyboard.</p>
          <ul class="files table">
            {shortcuts.map((s) => (
              <li class="shortcut">
                <span class="keys">
                  {s.keys.map((combo, i) => (
                    <>
                      {i > 0 && <span class="or" aria-label="or">/</span>}
                      <span class="combo">{combo.map((k) => <Kbd k={k} />)}</span>
                    </>
                  ))}
                </span>
                <span class="does">{s.does}</span>
              </li>
            ))}
          </ul>
          <p class="note">
            Mod means Command on macOS and Ctrl on Linux / Windows. Super is the Windows or logo key. Press <Kbd k="?" class="inline" /> inside Goop for the full list.
          </p>
        </article>

        <article id="agents" class="panel" hidden={initial !== 'agents'}>
          <h1>Agents: let your bots DM you</h1>
          <p class="tagline">Get updates from your agents. Reply in Goop.</p>
          <p class="more">
            Each agent needs its own Nostr identity and a NIP-17 integration. Give it your public key (npub) as its contact, then accept its first message in Requests.
          </p>
          <div class="prompt">
            <div class="prompt-head">
              <span>OpenClaw, tested with Goop. Send this to your agent:</span>
              <CopyButton target="openclaw-prompt" />
            </div>
            <pre id="openclaw-prompt">{openclawPrompt}</pre>
          </div>
          <p class="more">
            Replace <span class="name">PASTE_YOUR_NPUB_HERE</span> with your npub. Hermes and NullClaw have NIP-17 channels too, untested with Goop so far. <a href={`${guide}#agent-guide`}>Agent guide</a>
          </p>
        </article>

        <article id="guide" class="panel" hidden={initial !== 'guide'}>
          <h1>Usage guide</h1>
          <p class="tagline">The manual, on one page.</p>
          <ul class="files links">
            <li><a href={guide}><span class="name">dergigi.com/goop</span><span class="desc">the usage guide</span></a></li>
            <li><a href={`${guide}#keyboard-shortcuts`}><span class="name">#keyboard-shortcuts</span><span class="desc">every key, on every platform</span></a></li>
            <li><a href={`${guide}#agent-guide`}><span class="name">#agent-guide</span><span class="desc">OpenClaw, Hermes, NullClaw</span></a></li>
          </ul>
          <p class="more">
            If the guide leaves a question open, <a href={`${repo}/issues`}>open an issue</a>.
          </p>
        </article>

        <article id="source" class="panel" hidden={initial !== 'source'}>
          <h1>Source on GitHub</h1>
          <p class="tagline">Rust on GPUI. GPL-3.0. Fork of Coop.</p>
          <ul class="files links">
            {links.source.map((l) => (
              <li><a href={l.url}><span class="name">{l.name}</span><span class="desc">{l.desc}</span></a></li>
            ))}
          </ul>
          <p class="more">
            Goop follows Semantic Versioning and Keep a Changelog. Every release ships with a SHA256SUMS file, so you can check what you downloaded.
          </p>
        </article>

        <article id="nip17" class="panel" hidden={initial !== 'nip17'}>
          <h1>What is NIP-17?</h1>
          <p class="tagline">Private direct messages on Nostr.</p>
          <p class="more">
            Your message is wrapped three times. The unsigned message (the rumor) is sealed with your key, then the seal is gift-wrapped with a throwaway key and a randomised timestamp. Relays see a random sender and a blob, nothing else.
          </p>
          <ul class="files links">
            {links.nip17.map((l) => (
              <li><a href={l.url}><span class="name">{l.name}</span><span class="desc">{l.desc}</span></a></li>
            ))}
          </ul>
          <p class="more">
            Attachments are encrypted per file before upload; the key travels only inside the message.
          </p>
        </article>
      </section>

      <footer class="status">
        <a href={release.url}>goop v{release.version}</a>
        <span>
          <a href={goopProfile} title="Goop’s Nostr profile">Message Goop</a> · <a href={links.nip17[0].url}>NIP-17</a> · <a href={`${repo}/blob/master/LICENSE`}>GPL-3.0</a> · <a href="#macos">macOS</a> <a href="#windows">Windows</a> <a href="#linux">Linux</a>
        </span>
        <a class="hint-link" href="#shortcuts">? for shortcuts</a>
      </footer>
    </main>
    <script src="../scripts/palette.ts"></script>
  </body>
</html>

<style is:global>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .palette {
    display: grid;
    grid-template-columns: 40.3% 1fr;
    grid-template-rows: auto 1fr auto;
    grid-template-areas:
      'bar bar'
      'commands preview'
      'status status';
    height: 100dvh;
    min-height: 45rem;
  }

  /* Input bar */
  .bar {
    grid-area: bar;
    display: flex;
    align-items: center;
    height: 4.625rem;
    margin: 0.75rem 0.75rem 0;
    padding: 0 1.875rem 0 0.9375rem;
    border: var(--rule);
    border-radius: var(--radius);
  }
  .ghost {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    color: var(--text);
  }
  .query {
    flex: 1;
    display: flex;
    align-items: center;
    margin-left: 1.375rem;
    font-size: 2.125rem;
    font-weight: 600;
  }
  .query input {
    width: 4ch; /* palette.ts grows this with the value */
    max-width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    caret-color: transparent;
  }
  .query input::placeholder {
    color: var(--text);
    opacity: 1;
  }
  /* Our own caret: shows the same whether or not the input has focus. */
  .caret {
    flex: none;
    width: max(2px, 0.09em);
    height: 1.1em;
    margin-left: 0.08em;
    background: var(--brand);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .query input:focus-visible {
    outline: none;
  }
  .hint {
    font-size: 1.4375rem;
  }

  /* Command list */
  .commands {
    grid-area: commands;
    padding: 1.1875rem 1.125rem 0 1.1875rem;
    border-right: var(--rule);
    overflow-y: auto;
  }
  .commands ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    height: 3.4375rem;
    padding: 0.125rem 0;
  }
  .row a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    padding: 0 0.8125rem 0 1.1875rem;
    border-radius: 0.25rem;
    font-size: 1.4375rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .row .label {
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: 0.75rem;
  }
  .row.active a {
    background: var(--purple);
    color: #fff;
  }
  .row.active .key {
    color: #f3dafe;
    border-color: #f3dafe;
  }
  .no-match {
    padding: 1.125rem 1.1875rem;
    color: var(--lilac);
    font-size: 1.4375rem;
  }

  /* Preview */
  .preview {
    grid-area: preview;
    padding: 2.0625rem 2.25rem 0 1.875rem;
    overflow-y: auto;
    scrollbar-gutter: stable;
    mask-image: linear-gradient(to bottom, #000 calc(100% - 2.5rem), transparent);
  }
  /* Without JS, the hash picks the panel. With JS the script owns visibility;
     :target must not interfere since it ignores history.replaceState. */
  html:not(.js) .preview:has(.panel:target) .panel:not(:target) {
    display: none;
  }
  html:not(.js) .panel[hidden]:target {
    display: block;
  }
  .panel {
    scroll-margin-top: 2.0625rem;
    /* Runs each time a panel goes from hidden to shown. */
    animation: panel-in 120ms ease-out;
  }
  @keyframes panel-in {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel,
    .caret {
      animation: none;
    }
  }
  .panel h1 {
    margin: 0 0 0 0.5rem;
    font-size: 2.125rem;
    font-weight: 600;
    line-height: 1;
  }
  .tagline {
    margin: 1.1875rem 0 0 0.5rem;
    color: var(--lilac);
    font-size: 1.4375rem;
    line-height: 1.4;
  }
  .files {
    display: grid;
    grid-template-columns: minmax(20ch, max-content) max-content auto;
    column-gap: 2.5ch;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    border-top: var(--rule);
  }
  .files li {
    display: contents;
  }
  .files a,
  .files .row-static {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    align-items: center;
    height: 3.125rem;
    padding: 0 1rem;
    border-bottom: var(--rule);
    font-size: 1.4375rem;
  }
  .files .name,
  .files .size,
  .files .arch {
    white-space: nowrap;
  }
  .files.links {
    grid-template-columns: 1fr auto;
