---
import '../styles/global.css';
import Ghost from '../components/Ghost.astro';

const title = 'Clankers & friends | Goop';
const description = 'Filter your chats by bots or people. New in Goop 2.11.0, a native NIP-17 client for macOS, Windows, and Linux.';
const canonical = new URL('/clankers', Astro.site);
const image = new URL('/clankers-og.png', Astro.site);
const imageAlt = 'Goop 2.11.0: Clankers & friends. New bot and human chat filters.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/goop.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Goop" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="preload" href="/fonts/cascadia-code-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="page">
      <header><a class="brand" href="/" aria-label="Goop home"><Ghost class="ghost" />Goop</a></header>
      <main>
        <p class="eyebrow">New in Goop 2.11.0</p>
        <h1><span>Clankers</span><br />&amp; friends.</h1>
        <p class="intro">Filter your chats by bots or people.</p>
        <div class="filter-demo">
          <div class="demo-controls" role="group" aria-label="Try the chat filter" hidden>
            <button type="button" data-filter="all" aria-pressed="true" aria-controls="filter-preview">Show all</button>
            <button type="button" data-filter="bots" aria-pressed="false" aria-controls="filter-preview">Clankers only</button>
          </div>
          <div class="filter-preview" id="filter-preview" aria-live="polite">
            <svg data-preview="all" viewBox="2 2 564 304" role="img" aria-label="All pinned chats: Note to self, Goop, and Boris.">
              <image href="/clankers-all.png" width="568" height="306" />
            </svg>
            <img data-preview="bots" hidden src="/clankers-filter.png" width="564" height="228" alt="Clankers only: Goop and Boris. The robot filter is selected." />
          </div>
        </div>
        <p class="explanation">Tap a filter in your chat list. Tap it again to see everyone, including groups.</p>
        <section class="details" aria-labelledby="how-it-works">
          <h2 id="how-it-works">How it works</h2>
          <p>Goop reads <code>bot: true</code> from a profile’s metadata, as defined in <a href="https://github.com/nostr-protocol/nips/blob/master/24.md#kind-0">NIP-24</a>. It marks accounts that are fully or partly automated. Profiles without that flag appear under people. Goop relies on what each profile declares.</p>
          <p>Use the <a href="https://clawhub.ai/dergigi/nihao">nihao OpenClaw skill</a> to give your agent a Nostr identity, then follow our <a href="/#agents">agent setup guide</a> to start chatting.</p>
        </section>
        <a class="download" href="/#get">Get Goop <span aria-hidden="true">→</span></a>
        <p class="platforms">macOS · Windows · Linux</p>
      </main>
    </div>
  </body>
</html>

<script>
  const controls = document.querySelector<HTMLElement>('.demo-controls');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const previews = document.querySelectorAll<HTMLElement | SVGElement>('[data-preview]');
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      previews.forEach((preview) => {
        preview.toggleAttribute('hidden', preview.dataset.preview !== button.dataset.filter);
      });
    });
  });
  if (controls) controls.hidden = false;
</script>

<style>
  .page { width: min(100%, 42rem); min-height: 100svh; margin: 0 auto; padding: 2.5rem 1.5rem; display: flex; flex-direction: column; justify-content: center; gap: 2.5rem; }
  .brand { display: inline-flex; align-items: center; gap: .5rem; font-size: 1rem; font-weight: 600; }
  .brand :global(.ghost) { width: 1.5rem; height: 1.75rem; }
  p { margin: 0; }
  .eyebrow { color: var(--lilac-dim); font-size: .75rem; }
  h1 { margin: 1rem 0; font-size: clamp(2.4rem, 7vw, 3.8rem); font-weight: 600; line-height: 1.06; letter-spacing: -.06em; }
  h1 span { color: #b77aeb; }
  .intro { font-size: 1rem; color: var(--lilac); line-height: 1.5; }
  .filter-demo { max-width: 564px; margin: 1.5rem 0; }
  .demo-controls { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: .75rem; }
  .demo-controls[hidden], [data-preview][hidden] { display: none; }
  .demo-controls button { padding: .5rem .75rem; border: 1px solid var(--purple); border-radius: .5rem; background: transparent; color: var(--lilac); font: inherit; font-size: .8rem; cursor: pointer; }
  .demo-controls button[aria-pressed="true"] { background: var(--purple); color: var(--text); }
  .demo-controls button:hover { border-color: var(--lilac); }
  .filter-preview { aspect-ratio: 564 / 304; overflow: hidden; border-radius: .75rem; background: #f8f8f8; }
  .filter-preview > svg, .filter-preview > img { display: block; width: 100%; height: auto; }
  .filter-preview > [hidden] { display: none; }
  .explanation { max-width: 34rem; font-size: .9rem; line-height: 1.7; }
  .details { margin-top: 1.5rem; max-width: 34rem; font-size: .8rem; line-height: 1.7; color: var(--lilac-dim); }
  .details h2 { margin: 0 0 .5rem; font-size: .9rem; font-weight: 600; color: var(--text); }
  .details p + p { margin-top: 1rem; }
  .details a { color: var(--lilac); text-decoration: underline; text-underline-offset: .2em; }
  .details a:hover { color: var(--text); }
  .details code { color: var(--lilac); font-family: inherit; }
  .download { margin-top: 2rem; display: inline-flex; align-items: center; gap: 2rem; padding: .8rem 1rem; border-radius: var(--radius); background: var(--purple); color: var(--text); font-size: 1rem; }
  .download:hover { background: var(--brand); }
  .platforms { margin-top: .8rem; color: var(--lilac-dim); font-size: .7rem; line-height: 1.5; }
</style>
