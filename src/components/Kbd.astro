---
/**
 * One keycap. `k` is a key name: "Mod" renders ⌘ on macOS and Ctrl elsewhere
 * (decided by data-os on <html>; both shown without JS).
 */
interface Props {
  k: string;
  class?: string;
}
const { k, class: cls } = Astro.props;

const glyph: Record<string, string> = {
  Up: '↑',
  Down: '↓',
  Enter: '↵',
  Esc: 'esc',
  Tab: 'tab',
  Shift: 'shift',
  Comma: ',',
};
const label = glyph[k] ?? k;
---

{
  k === 'Mod' ? (
    <kbd class:list={['key', cls]} aria-label="Command or Control">
      <span class="mac"><svg class="cmd" aria-hidden="true" focusable="false"><use href="#i-cmd" /></svg></span>
      <span class="ctrl">Ctrl</span>
    </kbd>
  ) : (
    <kbd class:list={['key', cls]}>{label}</kbd>
  )
}

<style is:global>
  .key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3.05em;
    height: 2.05em;
    padding: 0 0.4em;
    border: 2px solid color-mix(in oklab, var(--lilac) 82%, var(--brand));
    border-radius: 0.4em;
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--lilac) 35%, transparent);
    font-family: var(--mono);
    font-size: 20px;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }
  .key .cmd {
    width: 0.8em;
    height: 0.8em;
  }
  .key .mac,
  .key .ctrl {
    display: inline-flex;
    align-items: center;
  }
  /* Without JS both variants show, separated by a slash. */
  .key .mac + .ctrl::before {
    content: '/';
    margin: 0 0.2em;
    opacity: 0.6;
  }
  html[data-os='mac'] .key .ctrl,
  html[data-os='other'] .key .mac {
    display: none;
  }
  html[data-os] .key .mac + .ctrl::before {
    content: none;
  }
</style>
